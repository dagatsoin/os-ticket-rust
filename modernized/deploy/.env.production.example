# =============================================================================
# Production environment TEMPLATE for the osTicket modernised backend.
# =============================================================================
# Copy to the runtime dir as `.env` on the VPS and fill in the REPLACE values:
#     cp .env.production.example /home/debian/apps/runtime/os-ticket-prod/.env
#     $EDITOR /home/debian/apps/runtime/os-ticket-prod/.env
#
# This template holds NO real secrets. The runtime `.env` (with real values) is
# NEVER committed — it is gitignored and lives only on the VPS.
# PM2 loads it via env_file (see ecosystem.config.js).
# =============================================================================

# --- Database ----------------------------------------------------------------
# Postgres role/db provisioned on the shared postgres container. Replace the
# password. The DB `osticket_prod` and role `osticket` are created once (README).
DATABASE_URL=postgres://osticket:REPLACE@127.0.0.1:5432/osticket_prod

# --- App ---------------------------------------------------------------------
# APP_ENV=production is the fail-safe default and DISABLES the /api/dev/*
# endpoints — keep it as production in prod.
APP_ENV=production
# Bind loopback only; nginx is the public edge and proxies to it.
APP_HOST=127.0.0.1
APP_PORT=3701
# CORS / absolute-URL origin for the public site.
APP_FRONTEND_ORIGIN=https://os-ticket.warfog.gg

# --- Blob store --------------------------------------------------------------
# On-disk root for uploaded attachment bytes (content-addressed). Must be
# writable by the PM2 user and survive restarts.
BLOB_ROOT=/home/debian/apps/runtime/os-ticket-prod/blobs

# --- Outbound email (SMTP) ---------------------------------------------------
# When SMTP_HOST is set the real SmtpMailer is used; leave SMTP_HOST empty to
# fall back to the recording StubMailer (no real mail). Fill in for prod mail.
SMTP_HOST=
SMTP_PORT=465
SMTP_FROM=
SMTP_FROM_NAME=
SMTP_USER=
SMTP_PASS=
# Connection security: implicit | starttls | none.
#   implicit = implicit TLS / SMTPS (standard for port 465)
#   starttls = plaintext then STARTTLS upgrade (standard for port 587)
#   none     = plaintext (local Mailpit on 3704, or bare port 25)
# When SMTP_TLS is UNSET it is inferred from SMTP_PORT: 465 -> implicit,
# 587 -> starttls, everything else -> none. Set explicitly to override.
SMTP_TLS=implicit

# -----------------------------------------------------------------------------
# NOTE: ADMIN_PASSWORD is NOT stored here. It is passed inline ONLY for the
# one-time seed run, so the admin account is not left on the public default:
#
#     ADMIN_PASSWORD='a-strong-password' \
#       DATABASE_URL="$DATABASE_URL" ./bin/seed
#
# (The seed reads ADMIN_PASSWORD from the environment; when unset it keeps the
# dev default. Never persist the real value in a file.)
# -----------------------------------------------------------------------------
