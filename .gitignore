.htaccess
php53.cgi
include/ost-config.php
*.sw[a-z]
.DS_Store
.vagrant
Vagrantfile

# Staging directory used for packaging script
stage

# --- Rust backend (Cargo workspace at repo root) ---
/target
**/*.rs.bk

# Local environment files (the committed .env.example is the template).
/backend/.env
.env

# TS-M2-A1 — SHA-256 filesystem blob store root (BLOB_ROOT, default
# <workspace>/var/blobs). Stored file bytes are local runtime state, never
# committed.
/var/blobs
/var/

# NOTE: the committed `.sqlx/` query cache (cargo sqlx prepare) is intentionally
# tracked so CI builds in SQLx offline mode without a live DB — do NOT ignore it.
