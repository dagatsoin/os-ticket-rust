.htaccess
php53.cgi
include/ost-config.php
*.sw[a-z]
.DS_Store
.vagrant
Vagrantfile

# Staging directory used for packaging script
stage

# --- Rust backend (Cargo workspace under modernized/) ---
/target
/modernized/target
**/*.rs.bk

# Production deploy artifacts — the linux/amd64 binaries built locally via
# modernized/Dockerfile and the built SPA. Reusable deploy assets under
# modernized/deploy/ ARE committed; only the built outputs are ignored.
/modernized/deploy/bin/
/modernized/frontend/dist/

# Local environment files (the committed .env.example is the template).
/backend/.env
/modernized/.env
.env

# TS-M2-A1 — SHA-256 filesystem blob store root (BLOB_ROOT, default
# <workspace>/var/blobs). Stored file bytes are local runtime state, never
# committed.
/var/blobs
/var/
/modernized/var/
# Blob store roots created when a test/binary runs with a non-root CWD
# (e.g. `cargo test -p api` resolves BLOB_ROOT relative to backend/api).
**/var/blobs
backend/*/var/

# NOTE: the committed `.sqlx/` query cache (cargo sqlx prepare) is intentionally
# tracked so CI builds in SQLx offline mode without a live DB — do NOT ignore it.
