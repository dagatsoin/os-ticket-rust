# osTicket modernisation backend — environment template.
# Copy to `backend/.env` (gitignored) and adjust as needed.

# Postgres DSN — shared Docker container `backend-db-1` (postgres:16) on :5432.
# Absence of this var boots the server with db: "down" (health stays observable).
DATABASE_URL=postgres://postgres:pass123@localhost:5432/osticket_dev

# Bind port for the Axum server (machine port convention, range 37xx).
APP_PORT=3701

# Host to bind (default 0.0.0.0).
# APP_HOST=0.0.0.0

# CORS origin — the Vite dev frontend.
APP_FRONTEND_ORIGIN=http://localhost:3702

# Deployment environment (TS-M1-A4b). `development` (default) keeps session/CSRF
# cookies non-Secure and exposes dev endpoints (GET /api/dev/mailbox).
# `production` makes cookies Secure and disables the dev endpoints (404).
APP_ENV=development

# Log filter (tracing EnvFilter). Default: info,api=debug,db=info,tower_http=info
# RUST_LOG=info

# Set by CI to build against the committed .sqlx/ cache without a live DB.
# SQLX_OFFLINE=true

# --- Outbound email (SMTP, DEVIATION D3) -------------------------------------
# Leave SMTP_HOST empty (the default) to keep the recording StubMailer + the
# GET /api/dev/mailbox dev endpoint. Set SMTP_HOST to activate real delivery.
# For local Mailpit (docker compose up -d mailpit): host localhost, port 3704.
# SMTP_HOST=localhost
# SMTP_PORT=3704
# SMTP_FROM=support@osticket.local
# SMTP_FROM_NAME=Support
# SMTP_USER=
# SMTP_PASS=
# Connection security: implicit | starttls | none. When UNSET it is inferred
# from SMTP_PORT (465 -> implicit, 587 -> starttls, else none — so Mailpit's
# 3704 stays plaintext). Set explicitly to override the port-based default.
# SMTP_TLS=none
